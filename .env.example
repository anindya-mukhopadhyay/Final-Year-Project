# ============================================================
# AnswerChain-Python Environment Configuration Example
# Copy to .env and configure for your local/deployment environment.
# NEVER commit .env or private cryptographic keys to version control.
# ============================================================

# Application Server (Default: 8000)
APP_HOST=127.0.0.1
APP_PORT=8000

# Authentication & Session Security
# Generate a strong random key in production: e.g. python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=change-this-in-production-to-a-cryptographically-secure-random-secret
TOKEN_EXPIRY_SECONDS=86400

# Node-to-Node Security & Authentication
# Shared node authentication token for peer synchronization & broadcast verification
NODE_AUTH_TOKEN=dev-node-peer-auth-token-389fbc8102

# Node Network Topology & URLs
NODE_UNIVERSITY_URL=http://127.0.0.1:5001
NODE_TEACHER_URL=http://127.0.0.1:5002
NODE_AUTHORITY_URL=http://127.0.0.1:5003

# Distributed Node Execution (used when running nodes/node.py directly)
# NODE_ID=node-1
# NODE_ROLE=UNIVERSITY
# NODE_PORT=5001
# PEERS=127.0.0.1:5002,127.0.0.1:5003

# TLS Configuration (For Remote Node Cluster Deployment)
TLS_ENABLED=false
TLS_VERIFY=false

# Key Storage Directory for Cryptographic Actor Identities
KEY_STORAGE_DIR=keys

# Storage Abstraction Settings
DOCUMENT_STORAGE_PATH=generated/marksheets

# Rate Limiting & Abuse Prevention
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_UPLOAD_MAX_REQUESTS=20
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=60
